{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/homepage3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agents",
      "destination": "/fr#agents",
      "permanent": true
    },
    {
      "source": "/agents/:id",
      "destination": "/fr/agents/:id",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/test-maya.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/test-maya",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
